<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/garden_goal_background"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.Budgetgarden.Goal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <TextView
            style="@style/GardenTitle"
            android:accessibilityHeading="true"
            android:text="@string/take_out" />

        <TextView
            android:id="@+id/available_funds_text"
            style="@style/GardenBody"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/withdraw_description" />

        <TextView
            style="@style/GardenGoalFieldLabel"
            android:labelFor="@id/spend_source_spinner"
            android:text="@string/spend_source_label" />

        <Spinner
            android:id="@+id/spend_source_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/GardenGoalFieldLabel"
            android:labelFor="@id/spend_amount_input"
            android:text="@string/spend_amount_label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/spend_amount_input"
            style="@style/GardenGoalTextInput"
            android:hint="@string/spend_amount_hint"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            style="@style/GardenGoalFieldLabel"
            android:labelFor="@id/spend_memo_input"
            android:text="@string/spend_memo_label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/spend_memo_input"
            style="@style/GardenGoalTextInput"
            android:hint="@string/spend_memo_hint"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spend_button"
            style="@style/GardenGoalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/spend_submit" />
    </LinearLayout>
</ScrollView>