<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/garden_goal_background"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.Budgetgarden.Goal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Page title -->
        <TextView
            style="@style/GardenTitle"
            android:accessibilityHeading="true"
            android:text="@string/upcoming_transactions_title" />

        <!-- Page description -->
        <TextView
            style="@style/GardenBody"
            android:gravity="start"
            android:text="@string/upcoming_transactions_subtitle" />

        <!-- List heading -->
        <TextView
            style="@style/GardenBody"
            android:layout_marginTop="16dp"
            android:gravity="start"
            android:textStyle="bold"
            android:text="@string/upcoming_transactions_heading" />

        <!-- Loading or empty status -->
        <TextView
            android:id="@+id/upcoming_status_text"
            style="@style/GardenBody"
            android:layout_marginTop="16dp"
            android:text="@string/upcoming_transactions_loading" />

        <!-- Transactions will be inserted here -->
        <LinearLayout
            android:id="@+id/upcoming_transactions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
